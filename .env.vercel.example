# Vercel environment variables — copy values into Vercel Dashboard → Settings → Environment Variables.
# Never commit a real .env file.

# Required: signs the admin session cookie. Generate a long random value locally.
SESSION_SECRET=replace-with-a-long-random-string

# Admin login (simple password as requested).
ADMIN_USER=admin
ADMIN_PASSWORD=admin1234

# Alternatively set a scrypt hash instead of ADMIN_PASSWORD (generated with `pnpm admin:hash`):
# ADMIN_PASSWORD_HASH=

# Vercel Blob variables (BLOB_READ_WRITE_TOKEN / BLOB_STORE_ID / VERCEL_OIDC_TOKEN)
# are added automatically when you connect a Blob store to the project in the dashboard.
# Optional override of the single JSON object used for all store data:
# STORE_BLOB_PATH=dream-store/store.json
